```bash
#!/bin/bash

# ============================================================
#  PARA CONVOY DEPLOY
#  Convoy Panel Automated Deployment Utility
#
#  Credits: Para
# ============================================================

set -Eeuo pipefail

# ------------------------- COLORS -----------------------------

RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'

BLUE='\033[1;34m'
CYAN='\033[1;36m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
MAGENTA='\033[1;35m'
WHITE='\033[1;37m'

# ------------------------- PATHS ------------------------------

PANEL_DIR="/var/www/convoy"
ENV_FILE="${PANEL_DIR}/.env"
BACKUP_DIR="/root/para-convoy-backups"

DB_NAME="convoy"
DB_USER="convoy_user"

# ------------------------- UI --------------------------------

header() {
    clear

    echo ""
    echo -e "  ${MAGENTA}${BOLD}╭──────────────────────────────────────────────╮${RESET}"
    echo -e "  ${MAGENTA}${BOLD}│${RESET}          ${WHITE}${BOLD}PARA CONVOY DEPLOY${RESET}             ${MAGENTA}${BOLD}│${RESET}"
    echo -e "  ${MAGENTA}${BOLD}│${RESET}        ${DIM}Panel Installation Utility${RESET}        ${MAGENTA}${BOLD}│${RESET}"
    echo -e "  ${MAGENTA}${BOLD}╰──────────────────────────────────────────────╯${RESET}"
    echo ""
    echo -e "  ${DIM}Automated deployment • Credits: Para${RESET}"
    echo ""
}

line() {
    echo -e "  ${DIM}──────────────────────────────────────────────${RESET}"
}

log_info() {
    echo -e "  ${CYAN}›${RESET} $1"
}

log_ok() {
    echo -e "  ${GREEN}✓${RESET} $1"
}

log_warn() {
    echo -e "  ${YELLOW}⚠${RESET} $1"
}

log_fail() {
    echo -e "  ${RED}✗${RESET} $1"
}

fatal() {
    log_fail "$1"
    exit 1
}

# ------------------------- ROOT -------------------------------

if [[ "$EUID" -ne 0 ]]; then
    echo -e "${RED}${BOLD}This installer must be executed as root.${RESET}"
    exit 1
fi

# ------------------------- SYSTEM -----------------------------

detect_system() {

    if [[ ! -f /etc/os-release ]]; then
        fatal "Unable to identify the operating system."
    fi

    . /etc/os-release

    if [[ "${ID:-}" != "debian" && "${ID_LIKE:-}" != *"debian"* ]]; then
        log_warn "This installer is designed for Debian-based systems."
        read -rp "Continue anyway? [y/N] " answer

        [[ "$answer" =~ ^[Yy]$ ]] || exit 1
    fi
}

# ------------------------- INPUT ------------------------------

collect_settings() {

    header

    echo -e "  ${WHITE}${BOLD}DEPLOYMENT CONFIGURATION${RESET}"
    line
    echo ""

    read -rp "  Panel domain/IP: " DOMAIN

    [[ -n "$DOMAIN" ]] ||
        fatal "A domain or IP address is required."

    echo ""

    echo -e "  ${WHITE}${BOLD}DATABASE${RESET}"
    echo ""

    read -rsp "  Database password: " DB_PASS
    echo ""

    [[ -n "$DB_PASS" ]] ||
        fatal "Database password cannot be empty."

    echo ""

    echo -e "  ${WHITE}${BOLD}SMTP CONFIGURATION${RESET}"
    echo -e "  ${DIM}Leave SMTP fields empty if you want to configure them later.${RESET}"
    echo ""

    read -rp "  SMTP host: " SMTP_HOST
    read -rp "  SMTP port [587]: " SMTP_PORT

    SMTP_PORT="${SMTP_PORT:-587}"

    read -rp "  SMTP username: " SMTP_USER

    if [[ -n "$SMTP_USER" ]]; then
        read -rsp "  SMTP password: " SMTP_PASS
        echo ""
    else
        SMTP_PASS=""
    fi

    read -rp "  From email: " MAIL_FROM

    if [[ -z "$MAIL_FROM" && -n "$SMTP_USER" ]]; then
        MAIL_FROM="$SMTP_USER"
    fi

    read -rp "  From name [Convoy]: " MAIL_NAME
    MAIL_NAME="${MAIL_NAME:-Convoy}"

    echo ""
    echo -e "  ${WHITE}${BOLD}DEPLOYMENT SUMMARY${RESET}"
    line

    echo -e "  Domain       : ${CYAN}${DOMAIN}${RESET}"
    echo -e "  Install path : ${CYAN}${PANEL_DIR}${RESET}"
    echo -e "  Database     : ${CYAN}${DB_NAME}${RESET}"
    echo -e "  DB user      : ${CYAN}${DB_USER}${RESET}"
    echo -e "  SMTP host    : ${CYAN}${SMTP_HOST:-not configured}${RESET}"
    echo ""

    read -rp "  Continue with installation? [Y/n] " confirm

    if [[ "$confirm" =~ ^[Nn]$ ]]; then
        echo ""
        log_warn "Installation cancelled."
        exit 0
    fi
}

# ------------------------- PACKAGES ---------------------------

prepare_packages() {

    header

    echo -e "  ${WHITE}${BOLD}SYSTEM PREPARATION${RESET}"
    line
    echo ""

    log_info "Refreshing APT package lists..."
    apt-get update -y >/dev/null

    log_info "Installing deployment utilities..."

    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        curl \
        wget \
        unzip \
        tar \
        ca-certificates \
        openssl \
        mariadb-server \
        git \
        >/dev/null

    log_ok "Base packages are ready."
}

# ------------------------- APACHE CLEANUP ---------------------

remove_apache() {

    if ! systemctl list-unit-files 2>/dev/null |
        grep -q '^apache2\.service'; then
        return
    fi

    echo ""
    log_info "Apache installation detected."

    if systemctl is-active --quiet apache2 2>/dev/null; then
        log_info "Stopping Apache..."
        systemctl stop apache2 || true
    fi

    systemctl disable apache2 >/dev/null 2>&1 || true

    log_info "Removing Apache packages..."

    DEBIAN_FRONTEND=noninteractive apt-get purge -y \
        apache2 \
        apache2-bin \
        apache2-data \
        apache2-utils \
        >/dev/null 2>&1 || true

    apt-get autoremove -y >/dev/null 2>&1 || true

    rm -rf /etc/apache2

    log_ok "Apache has been removed."
}

# ------------------------- MARIADB ----------------------------

setup_database() {

    echo ""
    echo -e "  ${WHITE}${BOLD}DATABASE SETUP${RESET}"
    line

    systemctl enable mariadb >/dev/null 2>&1
    systemctl restart mariadb

    systemctl is-active --quiet mariadb ||
        fatal "MariaDB failed to start."

    log_info "Creating Convoy database..."

    mariadb <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\`
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS '${DB_USER}'@'127.0.0.1'
    IDENTIFIED BY '${DB_PASS}';

ALTER USER '${DB_USER}'@'127.0.0.1'
    IDENTIFIED BY '${DB_PASS}';

GRANT ALL PRIVILEGES
    ON \`${DB_NAME}\`.*
    TO '${DB_USER}'@'127.0.0.1';

FLUSH PRIVILEGES;
SQL

    log_ok "MariaDB database configured."
}

# ------------------------- DOCKER -----------------------------

install_docker() {

    echo ""
    echo -e "  ${WHITE}${BOLD}CONTAINER RUNTIME${RESET}"
    line

    if command -v docker >/dev/null 2>&1; then
        log_ok "Docker is already installed."
    else
        log_info "Installing Docker Engine..."

        curl -fsSL https://get.docker.com | sh

        log_ok "Docker Engine installed."
    fi

    systemctl enable docker >/dev/null 2>&1 || true
    systemctl start docker

    docker --version

    if docker compose version >/dev/null 2>&1; then
        log_ok "Docker Compose is available."
    else
        fatal "Docker Compose plugin was not detected."
    fi
}

# ------------------------- PANEL FILES ------------------------

download_panel() {

    echo ""
    echo -e "  ${WHITE}${BOLD}CONVOY PANEL${RESET}"
    line

    mkdir -p "$BACKUP_DIR"

    if [[ -d "$PANEL_DIR" && -f "$ENV_FILE" ]]; then

        log_warn "Existing Convoy installation detected."

        local backup_file
        backup_file="${BACKUP_DIR}/env-$(date +%Y%m%d-%H%M%S).bak"

        cp "$ENV_FILE" "$backup_file"

        log_ok "Existing .env backed up to:"
        echo -e "       ${DIM}${backup_file}${RESET}"

    else

        mkdir -p "$PANEL_DIR"

        log_info "Downloading latest Convoy panel archive..."

        curl -fL \
            -o /tmp/convoy-panel.tar.gz \
            "https://github.com/convoypanel/panel/releases/latest/download/panel.tar.gz"

        log_info "Extracting panel files..."

        tar -xzf /tmp/convoy-panel.tar.gz \
            -C "$PANEL_DIR"

        rm -f /tmp/convoy-panel.tar.gz

        log_ok "Convoy files installed."
    fi
}

# ------------------------- ENVIRONMENT ------------------------

configure_environment() {

    echo ""
    echo -e "  ${WHITE}${BOLD}APPLICATION CONFIGURATION${RESET}"
    line

    cd "$PANEL_DIR"

    if [[ ! -f ".env.example" && ! -f ".env" ]]; then
        fatal "Convoy environment template was not found."
    fi

    if [[ ! -f ".env" ]]; then
        cp ".env.example" ".env"
    fi

    # Helper that safely updates an existing environment variable.
    set_env() {
        local key="$1"
        local value="$2"

        if grep -qE "^${key}=" .env; then
            sed -i "s|^${key}=.*|${key}=${value}|g" .env
        else
            echo "${key}=${value}" >> .env
        fi
    }

    set_env "APP_URL" "http://${DOMAIN}"
    set_env "APP_ENV" "production"
    set_env "APP_DEBUG" "false"

    set_env "DB_HOST" "127.0.0.1"
    set_env "DB_PORT" "3306"
    set_env "DB_DATABASE" "$DB_NAME"
    set_env "DB_USERNAME" "$DB_USER"
    set_env "DB_PASSWORD" "$DB_PASS"

    # Generate Redis password if the environment supports it.
    local redis_secret
    redis_secret="$(openssl rand -hex 24)"

    set_env "REDIS_PASSWORD" "$redis_secret"

    if [[ -n "$SMTP_HOST" ]]; then

        set_env "MAIL_MAILER" "smtp"
        set_env "MAIL_HOST" "$SMTP_HOST"
        set_env "MAIL_PORT" "$SMTP_PORT"
        set_env "MAIL_USERNAME" "$SMTP_USER"
        set_env "MAIL_PASSWORD" "$SMTP_PASS"
        set_env "MAIL_ENCRYPTION" "tls"
        set_env "MAIL_FROM_ADDRESS" "$MAIL_FROM"
        set_env "MAIL_FROM_NAME" "\"$MAIL_NAME\""

    fi

    chmod 640 .env

    log_ok "Environment configuration written."
}

# ------------------------- PERMISSIONS ------------------------

set_permissions() {

    echo ""
    log_info "Applying panel permissions..."

    chown -R www-data:www-data "$PANEL_DIR"

    if [[ -d "${PANEL_DIR}/storage" ]]; then
        chmod -R ug+rwx "${PANEL_DIR}/storage"
    fi

    if [[ -d "${PANEL_DIR}/bootstrap/cache" ]]; then
        chmod -R ug+rwx "${PANEL_DIR}/bootstrap/cache"
    fi

    log_ok "File permissions configured."
}

# ------------------------- CONTAINERS -------------------------

launch_stack() {

    echo ""
    echo -e "  ${WHITE}${BOLD}STARTING CONVOY${RESET}"
    line

    cd "$PANEL_DIR"

    log_info "Starting Docker services..."

    docker compose up -d

    log_ok "Containers started."

    sleep 3

    log_info "Installing production PHP dependencies..."

    docker compose exec -T workspace \
        bash -c "composer install --no-dev --optimize-autoloader"

    log_ok "Composer dependencies installed."

    log_info "Preparing Laravel application..."

    docker compose exec -T workspace \
        bash -c "php artisan key:generate --force"

    docker compose exec -T workspace \
        bash -c "php artisan optimize"

    log_ok "Application cache prepared."

    log_info "Running database migrations..."

    docker compose exec -T workspace \
        php artisan migrate --force

    log_ok "Database migrations completed."
}

# ------------------------- ADMIN -------------------------------

create_admin() {

    echo ""
    echo -e "  ${WHITE}${BOLD}ADMIN ACCOUNT${RESET}"
    line

    echo ""
    echo -e "  ${DIM}Convoy's interactive administrator creation command${RESET}"
    echo -e "  ${DIM}will now be opened.${RESET}"
    echo ""

    cd "$PANEL_DIR"

    docker compose exec workspace \
        php artisan c:user:make
}

# ------------------------- FINAL TEST -------------------------

verify_deployment() {

    echo ""
    echo -e "  ${WHITE}${BOLD}DEPLOYMENT VERIFICATION${RESET}"
    line

    local failed=0

    systemctl is-active --quiet mariadb \
        && log_ok "MariaDB: online" \
        || {
            log_fail "MariaDB: offline"
            failed=1
        }

    command -v docker >/dev/null 2>&1 \
        && log_ok "Docker: installed" \
        || {
            log_fail "Docker: missing"
            failed=1
        }

    cd "$PANEL_DIR"

    if docker compose ps >/dev/null 2>&1; then
        log_ok "Docker Compose: responding"
    else
        log_fail "Docker Compose: unavailable"
        failed=1
    fi

    [[ -f "$ENV_FILE" ]] \
        && log_ok "Convoy .env: present" \
        || {
            log_fail "Convoy .env: missing"
            failed=1
        }

    return "$failed"
}

# ------------------------- FINISH -----------------------------

finish_screen() {

    local server_ip
    server_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"

    clear

    echo ""
    echo -e "  ${GREEN}${BOLD}╔══════════════════════════════════════════════╗${RESET}"
    echo -e "  ${GREEN}${BOLD}║${RESET}          ${WHITE}${BOLD}CONVOY IS DEPLOYED${RESET}             ${GREEN}${BOLD}║${RESET}"
    echo -e "  ${GREEN}${BOLD}╚══════════════════════════════════════════════╝${RESET}"
    echo ""

    echo -e "  ${CYAN}${BOLD}PANEL INFORMATION${RESET}"
    line

    echo -e "  URL          : ${WHITE}http://${DOMAIN}${RESET}"
    echo -e "  Server IP    : ${WHITE}${server_ip}${RESET}"
    echo -e "  Install path : ${WHITE}${PANEL_DIR}${RESET}"

    echo ""
    echo -e "  ${CYAN}${BOLD}DATABASE${RESET}"
    line

    echo -e "  Database     : ${WHITE}${DB_NAME}${RESET}"
    echo -e "  User         : ${WHITE}${DB_USER}${RESET}"
    echo -e "  Password     : ${WHITE}${DB_PASS}${RESET}"

    echo ""
    echo -e "  ${YELLOW}${BOLD}NEXT STEP${RESET}"
    echo -e "  Visit ${CYAN}http://${DOMAIN}${RESET} and verify the panel."
    echo ""

    echo -e "  ${DIM}Credits: Para${RESET}"
    echo ""
}

# ------------------------- MAIN -------------------------------

detect_system
collect_settings
prepare_packages
remove_apache
setup_database
install_docker
download_panel
configure_environment
set_permissions
launch_stack
create_admin

if ! verify_deployment; then
    echo ""
    log_warn "Deployment completed with one or more verification warnings."
fi

finish_screen
```
