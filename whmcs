#!/bin/bash

# ============================================================
#  PARA WHMCS DEPLOYER
#  WHMCS + Nginx + PHP 8.4 + MariaDB
#
#  Credits: Para
# ============================================================

set -Eeuo pipefail

# ---------------------- CONFIG -------------------------------

APP_TITLE="PARA WHMCS DEPLOYER"
APP_VERSION="2.0"

INSTALL_DIR="/var/www/whmcs"
NGINX_SITE="/etc/nginx/sites-available/whmcs"
NGINX_LINK="/etc/nginx/sites-enabled/whmcs"

PHP_VERSION="8.4"
PHP_SOCKET="/run/php/php8.4-fpm.sock"

TEMP_DIR="/tmp/para-whmcs"
WHMCS_ARCHIVE="$TEMP_DIR/whmcs.zip"

DB_NAME="whmcs"
DB_USER="whmcs"

# ---------------------- COLORS --------------------------------

RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'

# ---------------------- UI ------------------------------------

banner() {
    clear

    echo ""
    echo -e "  ${MAGENTA}${BOLD}╔══════════════════════════════════════════════╗${RESET}"
    echo -e "  ${MAGENTA}${BOLD}║${RESET}          ${WHITE}${BOLD}PARA WHMCS DEPLOYER${RESET}             ${MAGENTA}${BOLD}║${RESET}"
    echo -e "  ${MAGENTA}${BOLD}║${RESET}       ${DIM}Automated Hosting Billing Setup${RESET}       ${MAGENTA}${BOLD}║${RESET}"
    echo -e "  ${MAGENTA}${BOLD}╚══════════════════════════════════════════════╝${RESET}"
    echo ""
    echo -e "  ${DIM}Version ${APP_VERSION}  •  Credits: Para${RESET}"
    echo ""
}

section() {
    echo ""
    echo -e "  ${CYAN}${BOLD}$1${RESET}"
    echo -e "  ${DIM}────────────────────────────────────────────${RESET}"
}

step() {
    echo -e "  ${BLUE}›${RESET} $1"
}

done_msg() {
    echo -e "  ${GREEN}✓${RESET} $1"
}

warn() {
    echo -e "  ${YELLOW}⚠${RESET} $1"
}

die() {
    echo -e "  ${RED}✗${RESET} $1"
    exit 1
}

# ---------------------- CLEANUP -------------------------------

cleanup() {
    rm -rf "$TEMP_DIR" 2>/dev/null || true
}

trap cleanup EXIT

# ---------------------- ROOT CHECK -----------------------------

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        die "Run this installer as root."
    fi
}

# ---------------------- INPUT ---------------------------------

ask_configuration() {

    section "INSTALLATION SETTINGS"

    read -rp "  WHMCS domain: " DOMAIN

    [[ -z "$DOMAIN" ]] && die "Domain cannot be empty."

    # Basic hostname validation
    if [[ ! "$DOMAIN" =~ ^[A-Za-z0-9.-]+$ ]]; then
        die "Invalid domain name."
    fi

    echo ""

    read -rsp "  MariaDB password for ${DB_USER}: " DB_PASSWORD
    echo ""

    [[ -z "$DB_PASSWORD" ]] && die "Database password cannot be empty."

    echo ""
    echo -e "  ${DIM}The WHMCS archive must come from your licensed WHMCS account.${RESET}"
    echo -e "  ${DIM}You can enter a local ZIP path or an HTTPS download URL.${RESET}"
    echo ""

    read -rp "  WHMCS ZIP path/URL: " WHMCS_SOURCE

    [[ -z "$WHMCS_SOURCE" ]] && die "WHMCS archive source is required."

    echo ""
    echo -e "  ${WHITE}${BOLD}Configuration${RESET}"
    echo ""
    echo -e "  Domain       : ${CYAN}${DOMAIN}${RESET}"
    echo -e "  Web root     : ${CYAN}${INSTALL_DIR}${RESET}"
    echo -e "  Database     : ${CYAN}${DB_NAME}${RESET}"
    echo -e "  DB user      : ${CYAN}${DB_USER}${RESET}"
    echo -e "  PHP          : ${CYAN}${PHP_VERSION}${RESET}"
    echo ""
}

# ---------------------- PHP REPOSITORY ------------------------

configure_php_repository() {

    section "PREPARING PHP ${PHP_VERSION}"

    # If PHP 8.4 already exists, no external repository is required.
    if command -v "php${PHP_VERSION}" >/dev/null 2>&1; then
        done_msg "PHP ${PHP_VERSION} is already available."
        return
    fi

    warn "PHP ${PHP_VERSION} is not currently installed."

    # Debian-based systems generally need an external PHP repository
    # for PHP 8.4 when their native repositories do not provide it.

    if ! command -v lsb_release >/dev/null 2>&1; then
        apt-get update -y
        apt-get install -y lsb-release ca-certificates apt-transport-https
    fi

    if [[ -f /etc/debian_version ]]; then

        step "Installing repository prerequisites"

        apt-get update -y

        apt-get install -y \
            ca-certificates \
            apt-transport-https \
            lsb-release \
            curl \
            gnupg

        if [[ ! -f /etc/apt/sources.list.d/php.list ]]; then

            step "Adding PHP package repository"

            curl -fsSL https://packages.sury.org/php/apt.gpg \
                | gpg --dearmor \
                | tee /usr/share/keyrings/sury-php.gpg >/dev/null

            echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" \
                > /etc/apt/sources.list.d/php.list
        fi

        apt-get update -y

    else
        die "This installer currently expects a Debian-based server."
    fi
}

# ---------------------- PACKAGES ------------------------------

install_stack() {

    section "INSTALLING SERVER COMPONENTS"

    step "Refreshing package information"
    apt-get update -y >/dev/null

    step "Installing web server and database"

    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        nginx \
        mariadb-server \
        unzip \
        curl \
        wget \
        openssl \
        ca-certificates \
        lsb-release \
        gnupg

    step "Installing PHP ${PHP_VERSION}"

    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        "php${PHP_VERSION}" \
        "php${PHP_VERSION}-fpm" \
        "php${PHP_VERSION}-cli" \
        "php${PHP_VERSION}-common" \
        "php${PHP_VERSION}-mysql" \
        "php${PHP_VERSION}-curl" \
        "php${PHP_VERSION}-xml" \
        "php${PHP_VERSION}-mbstring" \
        "php${PHP_VERSION}-gd" \
        "php${PHP_VERSION}-zip" \
        "php${PHP_VERSION}-intl" \
        "php${PHP_VERSION}-bcmath" \
        "php${PHP_VERSION}-soap"

    done_msg "Required packages installed."
}

# ---------------------- SERVICES ------------------------------

start_services() {

    section "STARTING SERVICES"

    systemctl enable nginx mariadb "php${PHP_VERSION}-fpm" >/dev/null 2>&1

    systemctl restart mariadb
    systemctl restart "php${PHP_VERSION}-fpm"
    systemctl restart nginx

    systemctl is-active --quiet mariadb \
        || die "MariaDB failed to start."

    systemctl is-active --quiet "php${PHP_VERSION}-fpm" \
        || die "PHP-FPM failed to start."

    systemctl is-active --quiet nginx \
        || die "Nginx failed to start."

    done_msg "Nginx is online."
    done_msg "MariaDB is online."
    done_msg "PHP-FPM is online."
}

# ---------------------- IONCUBE -------------------------------

install_ioncube() {

    section "INSTALLING IONCUBE LOADER"

    mkdir -p "$TEMP_DIR"

    step "Downloading ionCube loader"

    curl -fL \
        -o "$TEMP_DIR/ioncube.tar.gz" \
        "https://downloads.ioncube.com/loader_downloads/ioncube_loaders_lin_x86-64.tar.gz"

    step "Extracting loader"

    tar -xzf "$TEMP_DIR/ioncube.tar.gz" -C "$TEMP_DIR"

    local extension_dir

    extension_dir="$(
        "php${PHP_VERSION}" -i |
        awk -F'=> ' '/^extension_dir/ {print $2; exit}' |
        tr -d ' '
    )"

    [[ -z "$extension_dir" ]] &&
        die "Unable to determine PHP extension directory."

    local loader="$TEMP_DIR/ioncube/ioncube_loader_lin_${PHP_VERSION}.so"

    [[ -f "$loader" ]] ||
        die "ionCube loader for PHP ${PHP_VERSION} was not found."

    cp "$loader" "$extension_dir/"

    cat > "/etc/php/${PHP_VERSION}/mods-available/ioncube.ini" <<EOF
zend_extension=${extension_dir}/ioncube_loader_lin_${PHP_VERSION}.so
EOF

    phpenmod -v "$PHP_VERSION" ioncube

    systemctl restart "php${PHP_VERSION}-fpm"

    if "php${PHP_VERSION}" -v | grep -qi ioncube; then
        done_msg "ionCube loader enabled."
    else
        warn "ionCube was installed but could not be verified from CLI."
    fi
}

# ---------------------- DATABASE ------------------------------

configure_database() {

    section "CONFIGURING MARIADB"

    step "Creating WHMCS database"

    mariadb <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\`
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost'
    IDENTIFIED BY '${DB_PASSWORD}';

ALTER USER '${DB_USER}'@'localhost'
    IDENTIFIED BY '${DB_PASSWORD}';

GRANT ALL PRIVILEGES
    ON \`${DB_NAME}\`.*
    TO '${DB_USER}'@'localhost';

FLUSH PRIVILEGES;
SQL

    done_msg "Database created."
    done_msg "Database user configured."
}

# ---------------------- WHMCS FILES ---------------------------

install_whmcs() {

    section "DEPLOYING WHMCS"

    mkdir -p "$TEMP_DIR"
    mkdir -p "$INSTALL_DIR"

    if [[ "$WHMCS_SOURCE" =~ ^https?:// ]]; then

        step "Downloading WHMCS package"

        curl -fL \
            --retry 3 \
            -o "$WHMCS_ARCHIVE" \
            "$WHMCS_SOURCE"

    else

        [[ -f "$WHMCS_SOURCE" ]] ||
            die "WHMCS ZIP file does not exist: $WHMCS_SOURCE"

        step "Using supplied WHMCS package"

        cp "$WHMCS_SOURCE" "$WHMCS_ARCHIVE"
    fi

    [[ -s "$WHMCS_ARCHIVE" ]] ||
        die "WHMCS archive is empty."

    step "Extracting application"

    rm -rf "$INSTALL_DIR"
    mkdir -p "$INSTALL_DIR"

    unzip -q "$WHMCS_ARCHIVE" -d "$TEMP_DIR/extracted"

    # WHMCS ZIP files may contain a top-level whmcs directory.
    if [[ -d "$TEMP_DIR/extracted/whmcs" ]]; then
        cp -a "$TEMP_DIR/extracted/whmcs/." "$INSTALL_DIR/"
    else
        cp -a "$TEMP_DIR/extracted/." "$INSTALL_DIR/"
    fi

    chown -R www-data:www-data "$INSTALL_DIR"

    find "$INSTALL_DIR" -type d -exec chmod 755 {} \;
    find "$INSTALL_DIR" -type f -exec chmod 644 {} \;

    done_msg "WHMCS files deployed."
}

# ---------------------- NGINX --------------------------------

configure_nginx() {

    section "CONFIGURING NGINX"

    cat > "$NGINX_SITE" <<NGINX
server {
    listen 80;
    listen [::]:80;

    server_name ${DOMAIN};

    root ${INSTALL_DIR};
    index index.php index.html;

    client_max_body_size 100M;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCKET};
    }

    location ~ /\. {
        deny all;
    }

    location ~* \.(?:bak|conf|dist|fla|inc|ini|log|sh|sql|swp)$ {
        deny all;
    }
}
NGINX

    ln -sfn "$NGINX_SITE" "$NGINX_LINK"

    rm -f /etc/nginx/sites-enabled/default

    step "Checking Nginx configuration"

    nginx -t >/dev/null

    systemctl restart nginx

    done_msg "Nginx virtual host configured."
}

# ---------------------- CRON ---------------------------------

configure_cron() {

    section "CONFIGURING WHMCS CRON"

    local cron_file="${INSTALL_DIR}/crons/cron.php"

    if [[ ! -f "$cron_file" ]]; then
        warn "WHMCS cron.php was not found."
        return
    fi

    local existing

    existing="$(crontab -u www-data -l 2>/dev/null || true)"

    if ! grep -Fq "$cron_file" <<< "$existing"; then
        {
            printf '%s\n' "$existing"
            echo "*/5 * * * * /usr/bin/php${PHP_VERSION} -q ${cron_file}"
        } | crontab -u www-data -
    fi

    done_msg "WHMCS cron scheduled every 5 minutes."
}

# ---------------------- FINAL CHECK ---------------------------

verify_installation() {

    section "RUNNING FINAL CHECKS"

    local failed=0

    command -v nginx >/dev/null 2>&1 \
        && done_msg "Nginx binary detected." \
        || { failure "Nginx is missing."; failed=1; }

    command -v "php${PHP_VERSION}" >/dev/null 2>&1 \
        && done_msg "PHP ${PHP_VERSION} detected." \
        || { failure "PHP ${PHP_VERSION} is missing."; failed=1; }

    systemctl is-active --quiet mariadb \
        && done_msg "MariaDB service is active." \
        || { failure "MariaDB is not active."; failed=1; }

    systemctl is-active --quiet "php${PHP_VERSION}-fpm" \
        && done_msg "PHP-FPM service is active." \
        || { failure "PHP-FPM is not active."; failed=1; }

    systemctl is-active --quiet nginx \
        && done_msg "Nginx service is active." \
        || { failure "Nginx is not active."; failed=1; }

    [[ -f "$INSTALL_DIR/index.php" ]] \
        && done_msg "WHMCS entry point detected." \
        || warn "index.php was not found; verify the archive structure."

    return "$failed"
}

# ---------------------- COMPLETION ----------------------------

show_result() {

    local server_ip

    server_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"

    clear

    echo ""
    echo -e "  ${GREEN}${BOLD}╔══════════════════════════════════════════════╗${RESET}"
    echo -e "  ${GREEN}${BOLD}║${RESET}          ${WHITE}${BOLD}DEPLOYMENT COMPLETE${RESET}             ${GREEN}${BOLD}║${RESET}"
    echo -e "  ${GREEN}${BOLD}╚══════════════════════════════════════════════╝${RESET}"
    echo ""

    echo -e "  ${CYAN}${BOLD}WHMCS DETAILS${RESET}"
    echo -e "  ${DIM}────────────────────────────────────────────${RESET}"

    echo -e "  Domain       : ${WHITE}http://${DOMAIN}${RESET}"
    echo -e "  Server IP    : ${WHITE}${server_ip}${RESET}"
    echo -e "  Web root     : ${WHITE}${INSTALL_DIR}${RESET}"
    echo -e "  Database     : ${WHITE}${DB_NAME}${RESET}"
    echo -e "  DB user      : ${WHITE}${DB_USER}${RESET}"
    echo -e "  PHP          : ${WHITE}${PHP_VERSION}${RESET}"

    echo ""
    echo -e "  ${YELLOW}${BOLD}NEXT STEP${RESET}"
    echo -e "  Open ${CYAN}http://${DOMAIN}${RESET} and complete the"
    echo -e "  WHMCS web installer using your licensed installation."
    echo ""

    echo -e "  ${DIM}Credits: Para${RESET}"
    echo ""
}

# ---------------------- EXECUTION -----------------------------

require_root
banner
ask_configuration

configure_php_repository
install_stack
start_services
install_ioncube
configure_database
install_whmcs
configure_nginx
configure_cron

if ! verify_installation; then
    echo ""
    warn "One or more final checks reported a problem."
fi

show_result
