#!/bin/bash

# =========================================================
# PAYMENTER INSTALLER
# Premium Neon UI Edition
# =========================================================

set -e

# =========================================================
# NEON THEME
# =========================================================

CYAN='\033[38;5;51m'
PURPLE='\033[38;5;141m'
GRAY='\033[38;5;242m'
WHITE='\033[38;5;255m'
GREEN='\033[38;5;82m'
RED='\033[38;5;196m'
GOLD='\033[38;5;214m'
BLUE='\033[38;5;75m'
NC='\033[0m'

# =========================================================
# UI HELPERS
# =========================================================

typewrite() {
    local text="$1"
    local delay="${2:-0.015}"

    while IFS= read -r -n1 char; do
        printf "%s" "$char"
        sleep "$delay"
    done <<< "$text"

    echo
}

typewrite_inline() {
    local text="$1"
    local delay="${2:-0.015}"

    while IFS= read -r -n1 char; do
        printf "%s" "$char"
        sleep "$delay"
    done <<< "$text"
}

header_line() {
    echo -e "${GRAY}────────────────────────────────────────────────────────────${NC}"
}

section() {
    echo
    echo -e "${PURPLE}◆${NC} ${WHITE}$1${NC}"
    header_line
    echo
}

info() {
    echo -e "  ${PURPLE}•${NC} ${WHITE}$1${NC}"
}

success() {
    echo -e "  ${GREEN}✔${NC} $1"
}

warning() {
    echo -e "  ${GOLD}⚠${NC} $1"
}

fail() {
    echo -e "  ${RED}✖${NC} $1"
}

loading() {
    echo -ne "  ${PURPLE}◆${NC} $1 "

    for i in {1..3}; do
        echo -ne "${CYAN}.${NC}"
        sleep 0.25
    done

    echo
}

# =========================================================
# BANNER
# =========================================================

show_banner() {

    clear

    echo
    echo -e "${CYAN}"

    cat << "EOF"

  ___                         _
 | _ \__ _ _  _ _ __  ___ _ _| |_ ___ _ _
 |  _/ _` | || | '  \/ -_) ' \  _/ -_) '_|
 |_| \__,_|\_, |_|_|_\___|_||_\__\___|_|
           |__/

EOF

    echo -e "${NC}"

    echo -e "${GREEN}             P A Y M E N T E R${NC}"
    echo -e "${WHITE}             INSTALLER V2.0${NC}"
    echo -e "${GRAY}          Premium Deployment System${NC}"

    echo
    header_line
    echo

    typewrite_inline "${CYAN}Initializing deployment environment...${NC}" 0.018

    sleep 0.5

    echo
    echo -e "  ${GREEN}● SYSTEM READY${NC}"
    echo

    header_line
}

# =========================================================
# ROOT CHECK
# =========================================================

check_root() {

    if [[ "$EUID" -ne 0 ]]; then

        echo
        fail "This installer must be executed as root."
        echo
        echo -e "  ${GRAY}Try:${NC} ${WHITE}sudo bash installer.sh${NC}"
        echo

        exit 1
    fi

    success "Root privileges confirmed."
}

# =========================================================
# INPUT
# =========================================================

ask() {

    local label="$1"
    local default="$2"
    local var_name="$3"

    echo

    echo -e "  ${PURPLE}•${NC} ${WHITE}${label}${NC}"
    echo -e "    ${GRAY}Default: ${default}${NC}"

    echo -ne "    ${GRAY}╰─>${NC} "

    read input

    if [ -z "$input" ]; then
        printf -v "$var_name" '%s' "$default"
    else
        printf -v "$var_name" '%s' "$input"
    fi
}

# =========================================================
# CONFIGURATION
# =========================================================

collect_config() {

    section "CONFIGURATION"

    ask "Panel Domain" "billing.aiomarket.online" DOMAIN
    ask "Admin Email" "paymenter@gmail.com" EMAIL
    ask "Admin Password" "paymenter" PASSWORD

    echo
    echo -e "  ${GOLD}┌─[ REVIEW CONFIGURATION ]${NC}"
    echo -e "  ${GOLD}│${NC}"
    echo -e "  ${GOLD}│${NC} ${GRAY}Domain${NC}    : ${WHITE}${DOMAIN}${NC}"
    echo -e "  ${GOLD}│${NC} ${GRAY}Email${NC}     : ${WHITE}${EMAIL}${NC}"
    echo -e "  ${GOLD}│${NC} ${GRAY}Admin User${NC}: ${WHITE}My Admin${NC}"
    echo -e "  ${GOLD}│${NC} ${GRAY}Database${NC}  : ${WHITE}paymenter${NC}"
    echo -e "  ${GOLD}│${NC}"
    echo -e "  ${GOLD}└────────────────────────────────────${NC}"
}

# =========================================================
# CONFIRMATION
# =========================================================

confirm_install() {

    while true; do

        echo
        echo -ne "  ${CYAN}🚀 Start Installation?${NC} ${WHITE}(y/n)${NC}: "

        read -n 1 -r CONFIRM
        echo

        case "$CONFIRM" in

            [Yy])
                echo
                success "Deployment approved."
                break
                ;;

            [Nn])
                echo
                fail "Installation aborted by user."
                exit 0
                ;;

            *)
                warning "Please enter y or n."
                ;;

        esac

    done
}

# =========================================================
# PACKAGE SETUP
# =========================================================

install_packages() {

    section "SYSTEM PREPARATION"

    loading "Updating package repositories"

    apt update -y

    loading "Installing system utilities"

    apt install -y \
        curl \
        apt-transport-https \
        ca-certificates \
        gnupg \
        unzip \
        git \
        tar \
        sudo \
        lsb-release \
        software-properties-common \
        openssl

    success "System packages installed."
}

# =========================================================
# PHP REPOSITORY
# =========================================================

setup_php_repository() {

    section "PHP ENVIRONMENT"

    OS=$(lsb_release -is | tr '[:upper:]' '[:lower:]')

    if [[ "$OS" == "ubuntu" ]]; then

        info "Detected Ubuntu."

        loading "Adding PHP repository"

        LC_ALL=C.UTF-8 \
        add-apt-repository -y ppa:ondrej/php

        success "PHP repository configured."

    elif [[ "$OS" == "debian" ]]; then

        info "Detected Debian."

        loading "Adding SURY PHP repository"

        curl -fsSL \
            https://packages.sury.org/php/apt.gpg \
            | gpg --dearmor \
            -o /usr/share/keyrings/sury-php.gpg

        echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ $(lsb_release -cs) main" \
            | tee /etc/apt/sources.list.d/sury-php.list

        success "PHP repository configured."

    else

        warning "Unsupported distribution for automatic PHP repository setup."
        warning "Continuing with available system repositories."

    fi
}

# =========================================================
# REDIS REPOSITORY
# =========================================================

setup_redis_repository() {

    info "Configuring Redis repository..."

    curl -fsSL \
        https://packages.redis.io/gpg \
        | gpg --dearmor \
        -o /usr/share/keyrings/redis-archive-keyring.gpg

    echo "deb [signed-by=/usr/share/keyrings/redis-archive-keyring.gpg] https://packages.redis.io/deb $(lsb_release -cs) main" \
        | tee /etc/apt/sources.list.d/redis.list

    apt update -y

    success "Redis repository configured."
}

# =========================================================
# APPLICATION DEPENDENCIES
# =========================================================

install_application_dependencies() {

    section "APPLICATION DEPENDENCIES"

    loading "Installing PHP 8.3"

    apt install -y \
        php8.3 \
        php8.3-common \
        php8.3-cli \
        php8.3-gd \
        php8.3-mysql \
        php8.3-mbstring \
        php8.3-bcmath \
        php8.3-xml \
        php8.3-fpm \
        php8.3-curl \
        php8.3-zip \
        php8.3-intl \
        php8.3-redis \
        php8.3-tokenizer \
        php8.3-ctype \
        php8.3-simplexml \
        php8.3-dom

    loading "Installing database services"

    apt install -y \
        mariadb-server \
        nginx \
        redis-server

    success "Application dependencies installed."
}

# =========================================================
# PAYMENTER
# =========================================================

install_paymenter() {

    section "PAYMENTER CORE"

    mkdir -p /var/www/paymenter

    cd /var/www/paymenter

    loading "Downloading Paymenter"

    curl -Lo paymenter.tar.gz \
        https://github.com/paymenter/paymenter/releases/latest/download/paymenter.tar.gz

    loading "Extracting application"

    tar -xzvf paymenter.tar.gz >/dev/null

    chmod -R 755 storage bootstrap/cache

    success "Paymenter files installed."
}

# =========================================================
# DATABASE
# =========================================================

setup_database() {

    section "DATABASE SETUP"

    DB_NAME="paymenter"
    DB_USER="paymenter"
    DB_PASS="paymenter"

    loading "Creating database user"

    mysql -e \
        "CREATE USER IF NOT EXISTS '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASS}';"

    loading "Creating Paymenter database"

    mysql -e \
        "CREATE DATABASE IF NOT EXISTS ${DB_NAME};"

    loading "Granting database privileges"

    mysql -e \
        "GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_USER}'@'127.0.0.1' WITH GRANT OPTION;"

    mysql -e "FLUSH PRIVILEGES;"

    success "Database configured."
}

# =========================================================
# ENVIRONMENT
# =========================================================

setup_environment() {

    section "APPLICATION CONFIGURATION"

    cd /var/www/paymenter

    cp -n .env.example .env || true

    sed -i \
        "s|^DB_DATABASE=.*|DB_DATABASE=${DB_NAME}|g" \
        .env

    sed -i \
        "s|^DB_USERNAME=.*|DB_USERNAME=${DB_USER}|g" \
        .env

    sed -i \
        "s|^DB_PASSWORD=.*|DB_PASSWORD=${DB_PASS}|g" \
        .env

    loading "Generating application key"

    php artisan key:generate --force

    loading "Creating storage link"

    php artisan storage:link

    loading "Running database migrations"

    php artisan migrate --force --seed

    php artisan db:seed \
        --class=CustomPropertySeeder \
        --force

    success "Application environment configured."
}

# =========================================================
# CRON
# =========================================================

setup_cron() {

    section "TASK SCHEDULER"

    apt install -y cron

    systemctl enable --now cron

    (
        crontab -l 2>/dev/null \
        | grep -v "paymenter/artisan schedule:run" || true

        echo "* * * * * /usr/bin/php /var/www/paymenter/artisan schedule:run >> /dev/null 2>&1"

    ) | crontab -

    success "Paymenter scheduler configured."
}

# =========================================================
# SSL
# =========================================================

setup_ssl() {

    section "SECURE CONNECTION"

    mkdir -p /etc/certs/paymenter

    cd /etc/certs/paymenter

    loading "Generating SSL certificate"

    openssl req \
        -new \
        -newkey rsa:4096 \
        -days 3650 \
        -nodes \
        -x509 \
        -subj "/C=NA/ST=NA/L=NA/O=NA/CN=Generic SSL Certificate" \
        -keyout privkey.pem \
        -out fullchain.pem \
        >/dev/null 2>&1

    success "SSL certificate generated."
}

# =========================================================
# NGINX
# =========================================================

setup_nginx() {

    section "WEB SERVER"

    tee /etc/nginx/sites-available/paymenter.conf \
        > /dev/null << EOF

server {
    listen 80;
    listen [::]:80;

    server_name ${DOMAIN};

    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name ${DOMAIN};

    root /var/www/paymenter/public;

    index index.php index.html;

    charset utf-8;

    ssl_certificate /etc/certs/paymenter/fullchain.pem;
    ssl_certificate_key /etc/certs/paymenter/privkey.pem;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ ^/index\.php(/|$) {

        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;

        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;

        include fastcgi_params;

        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ {
        return 404;
    }

    client_max_body_size 100m;

    sendfile off;
}

EOF

    rm -f /etc/nginx/sites-enabled/default

    ln -sf \
        /etc/nginx/sites-available/paymenter.conf \
        /etc/nginx/sites-enabled/paymenter.conf

    loading "Testing Nginx configuration"

    nginx -t

    systemctl restart nginx

    chown -R www-data:www-data /var/www/paymenter

    success "Nginx configured successfully."
}

# =========================================================
# QUEUE SERVICE
# =========================================================

setup_services() {

    section "BACKGROUND SERVICES"

    tee /etc/systemd/system/paymenter.service \
        > /dev/null << 'EOF'

[Unit]
Description=Paymenter Queue Worker
After=network.target

[Service]
User=www-data
Group=www-data
Restart=always
ExecStart=/usr/bin/php /var/www/paymenter/artisan queue:work
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target

EOF

    systemctl daemon-reload

    loading "Starting Paymenter queue"

    systemctl enable --now paymenter.service

    loading "Starting Redis"

    systemctl enable --now redis-server

    success "Background services are running."
}

# =========================================================
# FINAL APPLICATION SETUP
# =========================================================

finalize_application() {

    section "FINAL APPLICATION SETUP"

    cd /var/www/paymenter

    loading "Running final migrations"

    php artisan migrate --force

    loading "Applying panel settings"

    php artisan tinker --execute="
DB::table('settings')->updateOrInsert(
    ['key'=>'company_name'],
    ['value'=>'Nobita Cloud']
);

DB::table('settings')->updateOrInsert(
    ['key'=>'timezone'],
    ['value'=>'Asia/Kolkata']
);

DB::table('settings')->updateOrInsert(
    ['key'=>'app_url'],
    ['value'=>'https://${DOMAIN}']
);
"

    loading "Building application cache"

    php artisan config:cache
    php artisan config:clear
    php artisan cache:clear
    php artisan config:cache

    loading "Creating administrator account"

    php artisan tinker --execute="
\App\Models\User::create([
    'first_name'=>'My',
    'last_name'=>'Admin',
    'email'=>'${EMAIL}',
    'password'=>bcrypt('${PASSWORD}'),
    'role_id'=>1,
    'is_admin'=>1
]);
"

    success "Administrator account created."
}

