        3) loading "Refreshing interface..." 1; menu ;;
        0)
            printf "\n"
            typewrite "${PINK}  Thanks for using PARA // PROXMOX INSTALLER!${RESET}" 0.025
            exit 0
            ;;
        *)
            printf "\n"
            typewrite "${RED}  ✘ Invalid option! Please select 0, 1, 2 or 3.${RESET}" 0.02
            sleep 1.5
            menu
            ;;
    esac
}

# Download and execute the selected installer
run_installer() {
    local os="$1"
    local url="$2"
    local temp_script

    printf "\n"
    typewrite "${PURPLE}  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}" 0.005
    typewrite "${CYAN}  Selected: ${WHITE}Proxmox VE on Debian ${os#Debian }${RESET}" 0.02
    typewrite "${YELLOW}  WARNING: This installer may modify system configuration.${RESET}" 0.02
    typewrite "${YELLOW}  Ensure you have a backup before continuing.${RESET}" 0.02
    printf "\n"

    read -rp "$(printf "${WHITE}  Continue with Debian ${os#Debian } installation? [y/N]: ${RESET}")" confirm

    case "$confirm" in
        [yY]|[yY][eE][sS]) ;;
        *)
            typewrite "${ORANGE}  Installation cancelled.${RESET}" 0.02
            sleep 1
            menu
            return
            ;;
    esac

    temp_script=$(mktemp) || {
        printf "${RED}  Failed to create temporary file.${RESET}\n"
        exit 1
    }

    printf "\n"
    loading "Downloading ${os} installer..." 1

    if ! curl -fLsS --connect-timeout 15 --max-time 120 "$url" -o "$temp_script"; then
        printf "\n${RED}  ✘ Download failed. Check your internet connection and URL.${RESET}\n"
        rm -f "$temp_script"
        read -rp "  Press Enter to return to menu..."
        menu
        return
    fi

    if [[ ! -s "$temp_script" ]]; then
        printf "${RED}  ✘ Downloaded installer is empty.${RESET}\n"
        rm -f "$temp_script"
        read -rp "  Press Enter to return to menu..."
        menu
        return
    fi

    if ! head -n 1 "$temp_script" | grep -qE '^#!|^$'; then
        printf "${RED}  ✘ Downloaded file does not look like a shell script.${RESET}\n"
        rm -f "$temp_script"
        read -rp "  Press Enter to return to menu..."
        menu
        return
    fi

    chmod 700 "$temp_script"

    printf "\n"
    typewrite "${GREEN}  ✔ Installer downloaded successfully.${RESET}" 0.02
    typewrite "${CYAN}  Launching Debian ${os#Debian } installer...${RESET}" 0.02
    printf "\n"

    # Run the selected installer and preserve its exit status.
    bash "$temp_script"
    local status=$?

    rm -f "$temp_script"

    printf "\n"
    if (( status == 0 )); then
        typewrite "${GREEN}  ✔ Installer process completed.${RESET}" 0.02
    else
        printf "${RED}  ✘ Installer exited with status ${status}.${RESET}\n"
    fi

    printf "\n"
    read -rp "  Press Enter to return to the menu..."
    menu
}

# Startup animation
clear
typewrite "${PURPLE}  ╔══════════════════════════════════════════════════════════╗${RESET}" 0.01
