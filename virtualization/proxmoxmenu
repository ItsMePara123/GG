}

# Menu
menu() {
    banner

    printf "${CYAN}  ┌──────────────────── INSTALLATION MENU ────────────────────┐${RESET}\n"
    printf "${CYAN}  │                                                           │${RESET}\n"
    printf "${CYAN}  │${RESET}  ${GREEN}[1]${RESET} ${WHITE}Proxmox VE Installer - Debian 12${RESET}                  ${CYAN}│${RESET}\n"
    printf "${CYAN}  │${RESET}      ${GRAY}Bookworm${RESET}                                             ${CYAN}│${RESET}\n"
    printf "${CYAN}  │                                                           │${RESET}\n"
