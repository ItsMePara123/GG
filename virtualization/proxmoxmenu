    printf "${PURPLE}║${YELLOW}       ██████╔╝███████║██████╔╝███████║                       ${PURPLE}║${RESET}\n"
    printf "${PURPLE}║${GREEN}       ██╔═══╝ ██╔══██║██╔══██╗██╔══██║                       ${PURPLE}║${RESET}\n"
