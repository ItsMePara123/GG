#!/usr/bin/env bash

# ============================================================
#              PARA // PROXMOX INSTALLER
#                 Credits: Para
#                    Version: 1.0
# ============================================================

# Root check
if [[ $EUID -ne 0 ]]; then
    echo "Please run this menu as root."
    exit 1
fi

# Installer URLs
DEBIAN12_URL="https://raw.githubusercontent.com/ItsMePara123/GG/refs/heads/main/virtualization/proxmoxinstallerdebian12"
DEBIAN13_URL="https://raw.githubusercontent.com/ItsMePara123/GG/refs/heads/main/virtualization/proxmoxinstallerdebain13"

# RGB colors
RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[38;5;196m'
PINK='\033[38;5;213m'
PURPLE='\033[38;5;135m'
BLUE='\033[38;5;39m'
CYAN='\033[38;5;51m'
GREEN='\033[38;5;46m'
YELLOW='\033[38;5;226m'
ORANGE='\033[38;5;208m'
WHITE='\033[38;5;255m'
GRAY='\033[38;5;245m'

# Typewriter effect
typewrite() {
    local text="$1"
    local delay="${2:-0.015}"

    for ((i=0; i<${#text}; i++)); do
        printf '%s' "${text:$i:1}"
        sleep "$delay"
    done
    printf '\n'
}

# Animated loading
loading() {
    local message="$1"
    local duration="${2:-2}"
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local end=$((SECONDS + duration))

    while (( SECONDS < end )); do
        for frame in "${frames[@]}"; do
            printf "\r${CYAN}  %s ${WHITE}%s${RESET}" "$frame" "$message"
            sleep 0.08
        done
    done

    printf "\r${GREEN}  ✔ ${WHITE}%s${RESET}\n" "$message"
}

# RGB gradient banner
banner() {
