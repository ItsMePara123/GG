    printf "${PURPLE}║${BLUE}       ╚═╝     ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝                       ${PURPLE}║${RESET}\n"
    printf "${PURPLE}║${PINK}                                                              ${PURPLE}║${RESET}\n"
