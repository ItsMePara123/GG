typewrite "${PURPLE}  ╚══════════════════════════════════════════════════════════╝${RESET}" 0.01
loading "Initializing RGB interface..." 2
typewrite "${GREEN}  ✔ Welcome to the installer menu, powered by Para.${RESET}" 0.02
sleep 1

menu
