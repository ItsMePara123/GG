#!/usr/bin/env bash

# =========================================================
# HVM PANEL V8 ULTRA INSTALLER
# Premium Terminal UI Edition
# =========================================================

set -euo pipefail

# =========================================================
# COLORS
# =========================================================

RED="\e[1;31m"
GREEN="\e[1;32m"
YELLOW="\e[1;33m"
BLUE="\e[1;34m"
CYAN="\e[1;36m"
MAGENTA="\e[1;35m"
WHITE="\e[1;37m"
DIM="\e[2m"
RESET="\e[0m"

# =========================================================
# VARIABLES
# =========================================================

HVM_URL="https://files.catbox.moe/rr0uum.bin"

INSTALL_DIR="/opt/hvm"
SERVICE_NAME="hvm"
PANEL_PORT="5000"

BIN_FILE="${INSTALL_DIR}/hvm.bin"
LOG_FILE="/var/log/hvm.log"

MIN_FILE_SIZE_MB=30

# =========================================================
# TERMINAL UI
# =========================================================

clear_screen() {
    clear
}

typewrite() {
    local text="$1"
    local delay="${2:-0.015}"

    while IFS= read -r -n1 char; do
        printf "%s" "$char"
        sleep "$delay"
    done <<< "$text"

    echo
}

typewrite_inline() {
    local text="$1"
    local delay="${2:-0.015}"

    while IFS= read -r -n1 char; do
        printf "%s" "$char"
        sleep "$delay"
    done <<< "$text"
}

line() {
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
}

small_line() {
    echo -e "${DIM}────────────────────────────────────────────────────────────${RESET}"
}

info() {
    echo -e " ${CYAN}◆${RESET} $1"
}

ok() {
    echo -e " ${GREEN}✔${RESET} $1"
}

warn() {
    echo -e " ${YELLOW}⚠${RESET} $1"
}

error() {
    echo -e " ${RED}✖${RESET} $1"
}

loading() {
    echo -ne " ${CYAN}◆${RESET} $1 "
    for i in {1..3}; do
        echo -ne "${CYAN}.${RESET}"
        sleep 0.25
    done
    echo
}

# =========================================================
# BANNER
# =========================================================

show_banner() {

    clear_screen

    echo
    echo -e "${CYAN}"
    cat << "EOF"

██╗  ██╗██╗   ██╗███╗   ███╗
██║  ██║██║   ██║████╗ ████║
███████║██║   ██║██╔████╔██║
██╔══██║╚██╗ ██╔╝██║╚██╔╝██║
██║  ██║ ╚████╔╝ ██║ ╚═╝ ██║
╚═╝  ╚═╝  ╚═══╝  ╚═╝     ╚═╝

EOF

    echo -e "${RESET}"

    echo -e "${WHITE}                 HVM PANEL V8${RESET}"
    echo -e "${DIM}             ULTRA INSTALLER${RESET}"
    echo

    line

    echo
    typewrite_inline "${CYAN}Initializing HVM installation environment...${RESET}" 0.018
    echo
